rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUserConfig(data) {
      return data.keys().hasAll(['createdAt', 'updatedAt']) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserConfig(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserConfig(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /sessions/{sessionId} {
        function isValidSession(data) {
          return data.keys().hasAll(['id', 'title', 'createdAt', 'updatedAt']) &&
                 data.id is string &&
                 data.title is string &&
                 data.createdAt is number &&
                 data.updatedAt is number;
        }

        allow read: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(sessionId) && isValidSession(incoming()) && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(sessionId) && isValidSession(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
